{
  // Template only. Not used by any command until DEC-002 is answered. Copy it, fill every
  // REPLACE_ value from docs/ENVIRONMENTS.md, then run scripts/check-release-config.mjs.
  // Secrets never go here: IP_HASH_KEY and OWNER_SUBJECT_ALLOWLIST use `wrangler secret put`.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "opsbridge-ai-staging",
  "main": "../backend/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health/*", "/admin", "/admin/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_ORIGIN": "REPLACE_HTTPS_ORIGIN",
    "OWNER_IDENTITY_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "REPLACE_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_ACCESS_AUD"
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "REPLACE_APP_HYPERDRIVE_ID" },
    { "binding": "HYPERDRIVE_CLEANUP", "id": "REPLACE_CLEANUP_HYPERDRIVE_ID" },
    { "binding": "HYPERDRIVE_DISPATCH", "id": "REPLACE_DISPATCH_HYPERDRIVE_ID" }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "triggers": { "crons": ["*/30 * * * *"] }
}
