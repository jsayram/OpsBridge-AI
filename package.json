{
  "name": "opsbridge-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --config frontend/vite.config.ts && wrangler dev",
    "build": "vite build --config frontend/vite.config.ts && wrangler deploy --dry-run --outdir dist/worker",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "audit": "npm audit --audit-level=high",
    "ci:local": "bash scripts/ci-local.sh",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:profile": "vitest run --config vitest.profile.config.ts",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:setup": "node scripts/db.mjs setup-local opsbridge_dev && DATABASE_MIGRATOR_URL=postgres://opsbridge_migrator:local_dev_only@127.0.0.1:54330/opsbridge_dev node scripts/db.mjs migrate && DATABASE_MIGRATOR_URL=postgres://opsbridge_migrator:local_dev_only@127.0.0.1:54330/opsbridge_dev node scripts/db.mjs seed",
    "smoke": "node scripts/smoke.mjs",
    "check:documents": "node scripts/fixtures/make-documents.mjs --check",
    "eval:ai": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "hono": "4.13.16",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "5.20261106.1",
    "@playwright/test": "1.65.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3",
    "unpdf": "2.1.0",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
