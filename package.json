{
  "name": "opsbridge-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --config frontend/vite.config.ts && wrangler dev",
    "build": "vite build --config frontend/vite.config.ts && wrangler deploy --dry-run --outdir dist/worker",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "audit": "npm audit --audit-level=high",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
